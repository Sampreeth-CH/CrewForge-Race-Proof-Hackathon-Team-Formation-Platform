rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'timezone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'role', 'timezone', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role == 'participant'
        && data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRaceExperiment(data) {
      return data.keys().hasAll(['experimentId', 'actorUid', 'totalRequests', 'winners', 'capacityRejections', 'passedAssertions', 'createdAt'])
        && data.keys().hasOnly(['experimentId', 'actorUid', 'totalRequests', 'winners', 'capacityRejections', 'passedAssertions', 'createdAt'])
        && isValidId(data.experimentId)
        && isValidId(data.actorUid)
        && data.actorUid == request.auth.uid
        && data.totalRequests is int && data.totalRequests >= 1 && data.totalRequests <= 500
        && data.winners is int && data.winners >= 0 && data.winners <= 50
        && data.capacityRejections is int && data.capacityRejections >= 0
        && data.passedAssertions is bool
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'timezone', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /team_snapshots/{teamId} {
      allow get: if isSignedIn() && isValidId(teamId);
      allow list: if isSignedIn() && existing().visibility == 'public';
      allow write: if false;
    }

    match /race_experiments/{experimentId} {
      allow get: if isSignedIn() && isValidId(experimentId) && (existing().actorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().actorUid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(experimentId)
        && isValidRaceExperiment(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if isAdmin();
    }
  }
}
