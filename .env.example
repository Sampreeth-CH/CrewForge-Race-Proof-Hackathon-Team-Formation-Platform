# GEMINI_API_KEY: Optional server-side key (AI Studio injects automatically if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL (used for CORS and links)
APP_URL="http://localhost:3000"

# Native PostgreSQL configuration (when set, uses pg.Pool; otherwise falls back to embedded PGlite)
# Option A: Individual host/credential variables (Docker Compose, Cloud SQL Proxy, or local Postgres)
SQL_HOST=""
SQL_PORT="5432"
SQL_DATABASE="crewforge"
SQL_USER=""
SQL_PASSWORD=""
SQL_SSL="false"
PG_POOL_MAX="30"

# Option B: Connection string for hosted PostgreSQL (Neon, Supabase, Render, Railway)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crewforge?sslmode=require"

# Authentication & Security (JWT_SECRET must be >=16 random chars in NODE_ENV=production)
JWT_SECRET="replace-with-strong-32-byte-random-secret"
COOKIE_SECURE="false"
# Comma-separated allowed frontend origin(s) for CORS in production (e.g. https://crewforge.app)
CORS_ORIGIN="http://localhost:3000"
# Optional frontend API base URL when hosting Vite static dist separately from Express backend
# VITE_API_URL="https://api.crewforge.app"
PORT="3000"
